{
  "name": "wispbit",
  "version": "2.0.0",
  "description": "AI-powered linter",
  "author": {
    "name": "Wispbit",
    "email": "support@wispbit.com"
  },
  "homepage": "https://wispbit.com",
  "repository": "https://github.com/wispbit-ai/claude-plugins",
  "license": "MIT",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wispbit handle-hooks claude.SessionStart"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "wispbit handle-hooks claude.PostToolUse"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wispbit handle-hooks claude.UserPromptSubmit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wispbit handle-hooks claude.Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wispbit handle-hooks claude.SessionEnd"
          }
        ]
      }
    ]
  }
}
